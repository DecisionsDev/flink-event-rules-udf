<!--
  Maven settings that give the build access to the Decision Intelligence Maven repository,
  where com.ibm.decision:engine-de-api is published.

  Copy this file to settings.xml (ignored by git), replace the two placeholders, then build with:
      mvn -s settings.xml package

  If your own ~/.m2/settings.xml already gives access to this repository, you do not need this file.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <profiles>
    <profile>
      <id>ads-maven</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <repositories>
        <repository>
          <id>ads-maven</id>
          <name>Decision Intelligence Maven repository</name>
          <!-- Replace with the URL of your Decision Intelligence Maven repository -->
          <url>%ADS_MAVEN_REPOSITORY_TO_BE_SET%</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <servers>
    <server>
      <id>ads-maven</id>
      <configuration>
        <httpHeaders>
          <property>
            <name>Authorization</name>
            <!-- Replace with your Zen API key -->
            <value>ZenApiKey %YOUR_API_KEY_TO_BE_SET%</value>
          </property>
        </httpHeaders>
      </configuration>
    </server>
  </servers>
</settings>
